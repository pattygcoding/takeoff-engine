# Takeoff Engine — frontend (Vite) environment template.
#
# Copy to `.env.local` (git-ignored) for `npm run dev:local` / `npm run build:local`, or set these
# keys in Infisical for the `infisical run` scripts. Every `VITE_*` value is PUBLIC: it is compiled
# into the browser bundle, so never put a secret here.
#
# See ../takeoff-engine-backend/docs/environment_variables_reference.md for the full reference.

# Public backend API base URL, including the /api suffix.
VITE_API_URL=http://localhost:5000/api

# Paddle's browser-safe client-side token for the environment selected below.
# Live tokens start with `live_`; sandbox tokens start with `test_`. Create them in the Paddle
# dashboard under Developer Tools > Authentication. Never use a Paddle API key here.
VITE_PADDLE_CLIENT_TOKEN=

# `production` (live, the default when unset) or `sandbox`.
# Live checkout returns a Paddle error until your account is verified and a domain is approved,
# so use `sandbox` for local runs and point VITE_PADDLE_CLIENT_TOKEN at the matching Sandbox token.
VITE_PADDLE_ENVIRONMENT=production

# Optional. Base URL for shareable client-proposal links; falls back to window.location.origin.
VITE_PUBLIC_PROPOSAL_BASE_URL=

# Informational only: `dev` or `prod`. Drives the landing-page badge, not the secret source.
VITE_INFISICAL_ENVIRONMENT=
