{
  "name": "takeoff-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "infisical run -- vite",
    "dev:local": "vite",
    "build": "infisical run --env=prod -- vite build",
    "build:local": "vite build",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "vitest run --config vitest.config.js",
    "test:unit:watch": "vitest --config vitest.config.js",
    "test:e2e": "playwright test --config playwright.e2e.config.js",
    "test:a11y": "playwright test",
    "test:a11y:public": "playwright test tests/accessibility/public-pages.spec.js",
    "translate": "python src/lang/lang.py",
    "translate:skip": "python src/lang/lang.py --skip",
    "translate:retry": "python src/lang/lang.py --retry",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "docx": "^9.7.1",
    "html2canvas-pro": "^2.3.8",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
